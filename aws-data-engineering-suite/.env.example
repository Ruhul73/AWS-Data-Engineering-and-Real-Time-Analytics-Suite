# AWS Configuration & Monorepo Environment Variables
# Copy to .env and populate with your AWS account credentials / resources

AWS_REGION=us-east-1
DATALAKE_BUCKET=aws-retail-datalake-demo-95a73
GLUE_DATABASE=retail_datalake_db
GLUE_JOB_NAME=glue_etl_bronze_to_silver
GLUE_ROLE_ARN=arn:aws:iam::123456789012:role/AWSGlueServiceRole-DataLake

KINESIS_STREAM=iot-sensor-stream
OPENSEARCH_HOST=https://search-iot-domain-xxxxxx.us-east-1.es.amazonaws.com
OPENSEARCH_ENDPOINT=https://search-iot-domain-xxxxxx.us-east-1.es.amazonaws.com
OPENSEARCH_DOMAIN=iot-metrics-domain
LAMBDA_FUNCTION_NAME=lambda_anomaly_processor
LAMBDA_ROLE_ARN=arn:aws:iam::123456789012:role/AWSLambdaKinesisExecutionRole

